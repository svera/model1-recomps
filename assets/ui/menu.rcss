/* The in-game menu. Sizes are in dp: the host sets 1dp = 1/720 of the window's height.
   The rows shrink and scroll to leave room for the help and footer.
   Gradients are the vertex-colour kind (horizontal-gradient): the SDL renderer has no shaders. */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 32dp;
	color: #dfe7fb;
}

div { display: block; }

#shade {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#040818f2 #04081850);
}

#panel {
	position: absolute;
	left: 5%;
	top: 26dp;
	bottom: 20dp;
	width: 90%;
	max-width: 700dp;
	display: flex;
	flex-direction: column;
}

#panel > div { flex-shrink: 0; }

#title {
	font-size: 56dp;
	font-weight: bold;
	font-style: italic;
	color: #ffd23f;
	height: 58dp;
	line-height: 58dp;
	padding-bottom: 3dp;
	border-bottom: 3dp #ffd23f;
}

#crumb {
	height: 32dp;
	line-height: 32dp;
	margin-bottom: 4dp;
	font-size: 25dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

#panel > #rows {
	flex-shrink: 1;
	width: 100%;
	overflow-x: hidden;
	overflow-y: auto;
}

scrollbarvertical { width: 16dp; background-color: #192442; }
scrollbarvertical slidertrack { width: 100%; }
scrollbarvertical sliderbar { width: 100%; min-height: 28dp; background-color: #6b81b8; }

.row {
	display: flex;
	box-sizing: border-box;
	width: 100%;
	height: 40dp;
	line-height: 40dp;
	padding: 0 16dp;
	margin-bottom: 2dp;
	color: #c3cff0;
	white-space: nowrap;
	transition: padding-left 0.12s cubic-out;
}

.row .label {
	flex: 1 1 auto;
	margin-right: 18dp;
}

.row .label, .row .value {
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
}

.row .value {
	flex: 0 1 auto;
	color: #ffd23f;
	text-align: right;
}

.row.selected {
	decorator: horizontal-gradient(#ffd23f #ff8f1f);
	color: #0b1430;
	padding-left: 28dp;
}

.row.selected .value { color: #0b1430; }

.row .arrow { color: #8fa3d6; }
.row.selected .arrow { color: #0b1430; }

.row.info {
	height: 34dp;
	line-height: 34dp;
	font-size: 25dp;
	font-weight: 500;
	margin-bottom: 0;
}

.row.info .value { color: #dfe7fb; }

/* a row belonging to the one above it (a player's seed, their secret character) */
.row.sub { padding-left: 40dp; font-size: 29dp; }
.row.sub .label { color: #9fb0dc; }
.row.sub.selected { padding-left: 52dp; }
.row.sub.selected .label { color: #0b1430; }

/* a mistake under its row (a character seed no fighter has) */
.row.error {
	height: 30dp;
	line-height: 30dp;
	padding-left: 52dp;
	font-size: 24dp;
	color: #ff6b5a;
}

/* a section's title: small capitals over a rule, a gap above it (not the first) */
.row.heading {
	height: 30dp;
	line-height: 30dp;
	margin-top: 10dp;
	margin-bottom: 4dp;
	font-size: 22dp;
	font-weight: 700;
	letter-spacing: 2dp;
	color: #8fa3d6;
	border-bottom: 1dp #3a4a78;
}
.row.heading:first-child { margin-top: 0; }

#note {
	margin-top: 8dp;
	height: 140dp;           /* five lines, including on narrow layouts */
	line-height: 28dp;
	overflow-x: hidden;
	overflow-y: auto;
	font-size: 24dp;
	font-weight: 500;
	color: #8fa3d6;
}

#hint {
	margin-top: 6dp;
	line-height: 26dp;
	font-size: 22dp;
	font-weight: 500;
	color: #8fa3d6;
}

#hint .binding { display: inline-block; margin-right: 12dp; white-space: nowrap; }

.key { color: #dfe7fb; }

/* the version and date, small, under the hint */
#ver {
	margin-top: 2dp;
	line-height: 24dp;
	font-size: 20dp;
	font-weight: 500;
	color: #8fa3d6;
}

@media (max-aspect-ratio: 4/5) {
	.row.with-value {
		flex-direction: column;
		height: 70dp;
		line-height: 34dp;
	}

	.row.with-value .label { flex: 0 0 auto; margin-right: 0; }
	.row.with-value .value { flex: 0 0 auto; text-align: left; }
}
